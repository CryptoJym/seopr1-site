---
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SEOPR1 — AI Search Visibility &amp; Automation for Firms</title>
<meta name="description" content="AI doesn't rank — it recommends. SEOPR1 tunes your firm's presence so AI cites you by name. AI visibility and automation for professional firms.">

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

<!-- Open Graph / Social Sharing -->
<meta property="og:type" content="website">
<meta property="og:url" content="https://seopr1.com/">
<meta property="og:title" content="SEOPR1 — AI Search Visibility &amp; Automation">
<meta property="og:description" content="AI doesn't rank — it recommends. Tune your firm to the frequency AI listens on.">
<meta property="og:image" content="https://seopr1.com/og-image.png?v=2">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="SEOPR1 — AI Search Visibility &amp; Automation">
<meta name="twitter:description" content="AI doesn't rank — it recommends. Tune your firm to the frequency AI listens on.">
<meta name="twitter:image" content="https://seopr1.com/og-image.png?v=2">

<link rel="canonical" href="https://seopr1.com/">

<!-- JSON-LD: Organization -->
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://seopr1.com/#organization",
  "name": "SEOPR1",
  "url": "https://seopr1.com/",
  "logo": {
    "@type": "ImageObject",
    "url": "https://seopr1.com/apple-touch-icon.png",
    "width": 180,
    "height": 180
  },
  "description": "AI search visibility and automation for professional firms. SEOPR1 tunes your firm's presence so AI assistants cite your firm by name.",
  "areaServed": "United States",
  "knowsAbout": [
    "Answer Engine Optimization",
    "AI Visibility",
    "Generative Engine Optimization",
    "AI-driven client intake automation",
    "Schema.org structured data",
    "Citation share measurement"
  ],
  "sameAs": []
}
</script>

<!-- JSON-LD: Service -->
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://seopr1.com/#service",
  "name": "AI Visibility & Automation for Professional Firms",
  "serviceType": "Answer Engine Optimization (AEO) and AI-driven client intake automation",
  "provider": { "@id": "https://seopr1.com/#organization" },
  "url": "https://seopr1.com/",
  "description": "Two-part platform tuning a professional firm's web presence so AI assistants like ChatGPT, Gemini, Perplexity, Claude, and Google AI Overviews cite the firm by name — and converting that attention into booked consultations through automated intake, qualification, scheduling, and follow-up.",
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Legal, accounting, financial advisory, and consulting firms"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "SEOPR1 Platform",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Visibility (AV)",
          "description": "Tune entity signals, schema markup, citation-worthy content, and consistent open-web naming so AI assistants recommend your firm by name."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Automation (AA)",
          "description": "Automated intake, qualification, scheduling, and follow-up. Sub-90-second response, 24/7 availability, no added headcount."
        }
      }
    ]
  }
}
</script>

<!-- JSON-LD: WebSite -->
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://seopr1.com/#website",
  "url": "https://seopr1.com/",
  "name": "SEOPR1",
  "publisher": { "@id": "https://seopr1.com/#organization" },
  "inLanguage": "en-US"
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Inter+Tight:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap">

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
<script is:inline src="/assets/lenis.min.js"></script>

<!-- Arm enhancement classes before first paint. If a CDN fails, the page
     stays fully readable in its static light form (no hidden panels). -->
<script is:inline>
(function () {
  var d = document.documentElement;
  if (window.THREE && window.gsap && window.ScrollTrigger) {
    d.classList.add('fx');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('fx-motion');
  }
})();
</script>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --font-body:    'Inter Tight', system-ui, -apple-system, sans-serif;
    --font-display: 'Bricolage Grotesque', 'Inter Tight', system-ui, sans-serif;
    --font-mono:    'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    /* legacy alias for any straggler references */
    --font: var(--font-body);

    /* ── Scroll-driven theme (JS writes these once per frame) ─────────
       Every color on the page derives from this set, so the whole DOM
       re-tunes in lockstep with the 3D environment — including pieces
       (stat labels, hud, rules) that previously fell out of sync. */
    --tp: 0;                              /* eased theme progress 0..1 */
    --ink:    #36454f;                    /* headings / strong text    */
    --muted:  #708090;                    /* body / labels             */
    --faint:  #9aa3a8;                    /* metadata / hints          */
    --line:   rgba(54,69,79,0.22);        /* hairlines                 */
    --btn-bg: #36454f;
    --btn-tx: #ffffff;
    --ghost-stroke: rgba(54,69,79,0.16);  /* oversized numerals        */
    --scrim-rgb: 255,255,255;             /* mobile legibility plate   */
    --cta-glow-a: 0;                      /* finale glow under CTA     */
    --spot: #ffffff;                      /* studio backdrop center    */
    --edge: #eceef0;                      /* studio backdrop vignette  */
  }

  html { scroll-behavior: auto; }

  body {
    font-family: var(--font-body);
    background: #ffffff;
    color: #111111;
    overflow-x: hidden;
    line-height: 1.6;
  }

  #bg-overlay {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100vh; height: 100dvh;
    background: #ffffff; z-index: 0;
  }

  /* Soft studio backdrop — a lit cyclorama behind the instrument instead
     of a flat color field. Center spot + vignette follow the theme. */
  #studio-backdrop {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100vh; height: 100dvh;
    z-index: 0;
    background: radial-gradient(120% 95% at 50% 40%, var(--spot) 0%, var(--edge) 78%);
  }

  /* Standing-wave field — ultra-faint concentric rings that give the
     mid-journey air some structure and tie the room to the fork. */
  #ring-field {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100vh; height: 100dvh;
    z-index: 0;
    opacity: 0;
    background: repeating-radial-gradient(circle at var(--ring-x, 50%) var(--ring-y, 42%),
      transparent 0 74px,
      var(--ring-c, rgba(120,130,142,0.05)) 74px 75px,
      transparent 75px 150px);
    transform: scale(1);
    will-change: opacity, transform;
    pointer-events: none;
  }

  #canvas-container {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100vh; height: 100dvh;
    z-index: 1;
  }
  canvas { display: block; }

  /* Film grain — kills the flat digital gray; generated at runtime. */
  #grain {
    position: fixed; top: -60px; left: -60px;
    width: calc(100% + 120px); height: calc(100vh + 120px); height: calc(100dvh + 120px);
    z-index: 60;
    opacity: calc(0.028 + var(--tp) * 0.022);
    pointer-events: none;
    background-repeat: repeat;
  }
  .fx-motion #grain { animation: grainShift 1.1s steps(5) infinite; }
  @keyframes grainShift {
    0%   { transform: translate(0, 0); }
    20%  { transform: translate(-28px, 14px); }
    40%  { transform: translate(16px, -22px); }
    60%  { transform: translate(-12px, -30px); }
    80%  { transform: translate(30px, 8px); }
    100% { transform: translate(0, 0); }
  }

  /* Ripple overlay — sits on top of everything */
  #ripple-canvas {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100vh; height: 100dvh;
    z-index: 150;
    pointer-events: none;
  }

  #scroll-spacer {
    position: relative; z-index: 2;
    pointer-events: none;
  }

  .content-section {
    position: relative; z-index: 3;
    pointer-events: none; /* let clicks fall through to the instrument */
    min-height: 100vh; min-height: 100dvh;
    display: flex; align-items: center;
    padding: 4rem 6vw;
  }

  .content-section:last-child {
    min-height: 100vh; min-height: 100dvh;
    margin-bottom: 0;
    padding-bottom: 4rem;
  }

  .content-panel {
    position: relative;
    max-width: 520px;
    pointer-events: auto;
  }

  .align-left  .content-panel { margin-right: auto; }
  .align-right .content-panel { margin-left: auto; }
  .align-center .content-panel { margin: 0 auto; text-align: center; max-width: 640px; }

  /* ── Oversized ghost numerals — depth + editorial rhythm ─────────── */
  .ghost-num {
    position: absolute;
    top: 50%; transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(14rem, 30vw, 26rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ghost-stroke);
    user-select: none;
    pointer-events: none;
    z-index: 0;
  }
  .align-right .ghost-num { left: 2vw; }
  .align-left  .ghost-num { right: 2vw; }

  /* ── Reveal machinery ────────────────────────────────────────────── */
  /* Static-first: everything is visible by default. Only when the fx
     class is armed do initial hidden states apply (JS then animates). */
  .tl { display: block; overflow: hidden; }
  .tl-i { display: block; }
  html.fx .tl-i { transform: translateY(112%); }
  html.fx .rv { opacity: 0; transform: translateY(18px); }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 1.5rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 600; line-height: 1.02;
    letter-spacing: -0.025em;
    font-variation-settings: "opsz" 96;
    margin-bottom: 1.5rem; color: var(--ink);
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.66rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 0.75rem;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 600; line-height: 1.1; margin-bottom: 1rem;
    letter-spacing: -0.015em;
    font-variation-settings: "opsz" 48;
    color: var(--ink);
  }
  .section-body {
    font-size: 1rem; font-weight: 300;
    line-height: 1.7; color: var(--muted); margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block; padding: 0.9rem 2.2rem;
    border-radius: 999px; font-size: 0.88rem; font-weight: 600;
    text-decoration: none; cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.3s, background 0.3s, color 0.3s, border-color 0.3s;
    pointer-events: auto;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn:active { transform: translateY(0); transition-duration: 0.12s; }
  .btn:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .btn-primary {
    background: var(--btn-bg); color: var(--btn-tx); border: none;
    box-shadow: 0 4px 20px rgba(20, 26, 31, 0.18);
  }
  .btn-primary:hover { box-shadow: 0 10px 34px rgba(20, 26, 31, 0.28); }
  .btn-ghost {
    background: transparent; color: var(--ink);
    border: 1.5px solid var(--line); margin-left: 0.75rem;
  }
  .btn-ghost:hover { border-color: var(--ink); }

  /* Finale: the primary CTA keeps ringing after the strike. */
  .btn-primary.ringing { animation: ctaRing 3.2s ease-out infinite; }
  @keyframes ctaRing {
    0%   { box-shadow: 0 10px 34px rgba(20,26,31,0.28), 0 0 0 0 rgba(235,240,248,0.34); }
    60%  { box-shadow: 0 10px 34px rgba(20,26,31,0.28), 0 0 0 22px rgba(235,240,248,0); }
    100% { box-shadow: 0 10px 34px rgba(20,26,31,0.28), 0 0 0 0 rgba(235,240,248,0); }
  }

  .stat-row { display: flex; gap: 2.5rem; margin-top: 1.75rem; }
  .stat-row > div {
    position: relative;
    padding-top: 0.85rem;
  }
  .stat-row > div::before {
    content: "";
    position: absolute; top: 0; left: 0;
    width: 2.2rem; height: 1px;
    background: var(--line);
    transform-origin: left center;
  }
  html.fx .stat-row > div::before { transform: scaleX(0); }
  html.fx .stats-live .stat-row > div::before {
    transform: scaleX(1);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.7rem; font-weight: 600;
    color: var(--ink); letter-spacing: -0.02em;
    font-feature-settings: "tnum" 1, "lnum" 1;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.62rem; font-weight: 500; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.1em;
    opacity: 0.85;
  }

  body > nav {
    position: fixed; top: 0; left: 0; width: 100%; z-index: 100;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.25rem 3vw; background: transparent;
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  }
  .nav-logo {
    font-family: var(--font-mono);
    font-size: 0.85rem; font-weight: 600;
    letter-spacing: 0.16em; color: var(--ink); text-decoration: none;
  }
  .nav-logo:focus-visible, .nav-links a:focus-visible {
    outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 2px;
  }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    position: relative;
    font-family: var(--font-mono);
    color: var(--muted); text-decoration: none;
    font-size: 0.74rem; font-weight: 500; letter-spacing: 0.04em;
    transition: color 0.25s;
    padding-bottom: 0.3rem;
  }
  .nav-links a::after {
    content: "";
    position: absolute; left: 0; bottom: 0;
    width: 100%; height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a:hover::after { transform: scaleX(0.4); }
  .nav-links a.active { color: var(--ink); }
  .nav-links a.active::after { transform: scaleX(1); }

  .scroll-hint {
    position: fixed; bottom: 2.5rem; left: 50%;
    transform: translateX(-50%); z-index: 50;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    opacity: 1; transition: opacity 0.5s;
  }
  .scroll-hint.hidden { opacity: 0; pointer-events: none; }
  .scroll-hint span {
    font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--faint); font-weight: 500;
  }
  .scroll-arrow {
    width: 18px; height: 18px;
    border-right: 1.5px solid var(--faint); border-bottom: 1.5px solid var(--faint);
    transform: rotate(45deg);
  }
  .fx-motion .scroll-arrow { animation: bobDown 1.8s ease-in-out infinite; }
  @keyframes bobDown {
    0%, 100% { transform: rotate(45deg) translateY(0); }
    50% { transform: rotate(45deg) translateY(5px); }
  }

  .progress-bar {
    position: fixed; top: 0; left: 0; height: 1.5px;
    background: var(--ink);
    opacity: 0.55;
    z-index: 200; width: 0%;
  }

  /* ── Instrument HUD — the page's tuner ───────────────────────────── */
  .hud {
    position: fixed; bottom: 2.1rem; left: 3vw;
    z-index: 90;
    display: flex; align-items: baseline; gap: 0.85rem;
    font-family: var(--font-mono);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease 0.2s;
  }
  html.fx .hud { opacity: 1; }
  html.fx.footer-vis .hud { opacity: 0; transition-delay: 0s; }
  .hud-pitch {
    font-size: 0.62rem; font-weight: 600;
    letter-spacing: 0.16em; color: var(--faint);
  }
  .hud-hz {
    font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.06em; color: var(--muted);
    font-feature-settings: "tnum" 1, "lnum" 1;
    min-width: 6.4ch;
  }
  .hud-state {
    font-size: 0.6rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--faint);
    transition: color 0.4s;
  }
  .hud.in-tune .hud-state { color: var(--ink); }
  .fx-motion .hud.in-tune .hud-state { animation: tunePulse 2.6s ease-in-out infinite; }
  @keyframes tunePulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  #wave-canvas {
    position: fixed; bottom: 1.9rem; right: 3vw;
    z-index: 90;
    width: 156px; height: 36px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.8s ease 0.2s;
  }
  html.fx #wave-canvas { opacity: 0.9; }
  html.fx.footer-vis #wave-canvas { opacity: 0; transition-delay: 0s; }

  .silver-line {
    width: 40px; height: 1.5px;
    background: var(--line);
    margin: 0 auto 1.5rem;
  }

  /* Finale glow — grounds the CTA text against the instrument. */
  .align-center .content-panel::before {
    content: "";
    position: absolute; inset: -3.5rem -4rem;
    background: radial-gradient(closest-side, rgba(5, 6, 9, var(--cta-glow-a)) 20%, transparent 75%);
    filter: blur(6px);
    z-index: -1;
    pointer-events: none;
  }

  /* Footer */
  .site-footer {
    position: relative; z-index: 3;
    pointer-events: auto;
    padding: 3rem 6vw 2.5rem;
    border-top: 1px solid var(--line);
    background: transparent;
  }
  .footer-inner {
    max-width: 1100px; margin: 0 auto;
    display: flex; flex-wrap: wrap; gap: 1.5rem 3rem;
    align-items: baseline; justify-content: space-between;
  }
  .footer-brand {
    font-size: 0.85rem; font-weight: 700;
    letter-spacing: 0.18em; color: var(--ink);
  }
  .footer-nav {
    display: flex; flex-wrap: wrap; gap: 1.75rem;
  }
  .footer-nav a {
    color: var(--muted); text-decoration: none;
    font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.04em; transition: color 0.2s;
  }
  .footer-nav a:hover { color: var(--ink); }
  .footer-meta {
    font-size: 0.7rem; color: var(--faint);
    letter-spacing: 0.08em; flex-basis: 100%;
    margin-top: 0.5rem;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .ghost-num { font-size: clamp(10rem, 34vw, 16rem); opacity: 0.8; }
  }

  @media (max-width: 760px) {
    .content-section { padding: 4.5rem 5vw; }

    /* Legibility plate: the fork passes directly behind copy on small
       screens, so panels sit on a frosted card that follows the theme. */
    html.fx .content-panel {
      background: rgba(var(--scrim-rgb), 0.6);
      backdrop-filter: blur(18px) saturate(1.05);
      -webkit-backdrop-filter: blur(18px) saturate(1.05);
      padding: 1.6rem 1.4rem;
      border-radius: 20px;
      border: 1px solid rgba(var(--scrim-rgb), 0.35);
      box-shadow: 0 18px 50px rgba(10, 14, 18, 0.12);
    }
    .align-center .content-panel::before { display: none; }

    .nav-links { gap: 1.1rem; }
    .nav-links li:not(:last-child) { display: none; }

    #wave-canvas { display: none; }
    .hud { bottom: 1.6rem; }

    .btn { padding: 0.85rem 1.7rem; font-size: 0.84rem; }
    .btn-ghost { margin-left: 0.5rem; }
    .stat-row { gap: 1.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    html.fx .tl-i { transform: none; }
    html.fx .rv { opacity: 1; transform: none; }
    html.fx .stat-row > div::before { transform: scaleX(1); }
    .btn, .nav-links a::after { transition-duration: 0.01s; }
  }
</style>
</head>
<body>

<!-- SVG filter for DOM element ripple distortion (applied per-element, not wrapper) -->
<svg style="position:absolute;width:0;height:0;pointer-events:none" aria-hidden="true">
  <filter id="dom-ripple" x="-5%" y="-5%" width="110%" height="110%">
    <feTurbulence id="dom-turb" type="turbulence" baseFrequency="0.015 0.008" numOctaves="3" seed="5" result="turb"/>
    <feDisplacementMap id="dom-displace" in="SourceGraphic" in2="turb" scale="0" xChannelSelector="R" yChannelSelector="G"/>
  </filter>
</svg>

<div id="bg-overlay"></div>
<div id="studio-backdrop"></div>
<div id="ring-field" aria-hidden="true"></div>
<div class="progress-bar" id="progressBar"></div>
<canvas id="ripple-canvas"></canvas>
