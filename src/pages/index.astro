<script is:inline>
(function () {
'use strict';

/* ═══════════════════════════════════════════════════
   BOOT GUARD
   Static page remains fully readable if any library
   failed; in that case strip the fx classes and bail.
   ═══════════════════════════════════════════════════ */
const docEl = document.documentElement;
if (!(window.THREE && window.gsap && window.ScrollTrigger)) {
  docEl.classList.remove('fx', 'fx-motion');
  return;
}

const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const COARSE  = window.matchMedia('(pointer: coarse)').matches;

let renderer;
try {
  renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
} catch (e) {
  // No WebGL: keep the DOM experience (reveals + theme) without 3D.
  renderer = null;
}

/* ═══════════════════════════════════════════════════
   FILM GRAIN (generated once — no network, tiny cost)
   ═══════════════════════════════════════════════════ */
(function makeGrain() {
  const g = document.createElement('canvas');
  g.width = 128; g.height = 128;
  const gx = g.getContext('2d');
  const img = gx.createImageData(128, 128);
  for (let i = 0; i < img.data.length; i += 4) {
    const v = 90 + Math.random() * 90;
    img.data[i] = img.data[i + 1] = img.data[i + 2] = v;
    img.data[i + 3] = 255 * (Math.random() * 0.55 + 0.2);
  }
  gx.putImageData(img, 0, 0);
  document.getElementById('grain').style.backgroundImage = `url(${g.toDataURL()})`;
})();

/* ═══════════════════════════════════════════════════
   SMOOTH SCROLL — Lenis (desktop, fine pointer only)
   ═══════════════════════════════════════════════════ */
gsap.registerPlugin(ScrollTrigger);

let lenis = null;
if (!REDUCED && !COARSE && window.Lenis) {
  lenis = new Lenis({ lerp: 0.095, wheelMultiplier: 1.0 });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((time) => lenis.raf(time * 1000));
  gsap.ticker.lagSmoothing(0);
}

// Anchor navigation goes through the smoother when it exists.
document.querySelectorAll('a[href^="#"]').forEach((a) => {
  a.addEventListener('click', (e) => {
    const id = a.getAttribute('href');
    if (id.length < 2) return;
    const target = document.querySelector(id);
    if (!target) return;
    e.preventDefault();
    if (lenis) lenis.scrollTo(target, { offset: 0, duration: 1.6 });
    else target.scrollIntoView(REDUCED ? {} : { behavior: 'smooth' });
  });
});

/* ═══════════════════════════════════════════════════
   THEME ENGINE
   One scroll progress → CSS custom properties.
   Everything on the page reads these vars, so DOM and
   3D re-tune together (fixes the stranded stat labels).
   ═══════════════════════════════════════════════════ */
const themePairs = {
  '--ink':    [[54, 69, 79],    [244, 246, 248]],
  '--muted':  [[112, 128, 144], [201, 206, 214]],
  '--faint':  [[154, 163, 168], [139, 147, 156]],
  '--btn-bg': [[54, 69, 79],    [244, 246, 248]],
  '--btn-tx': [[255, 255, 255], [30, 39, 46]],
  '--spot':   [[255, 255, 255], [24, 28, 33]],
  '--edge':   [[236, 238, 240], [5, 6, 8]],
};
const lerpC = (a, b, t) => `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(',')})`;

const ringField = document.getElementById('ring-field');
const bgOverlay = document.getElementById('bg-overlay');
let lastThemeP = -1;
let themeMuted = 'rgb(112,128,144)'; // cached for the waveform stroke

function applyTheme(p) {
  if (Math.abs(p - lastThemeP) < 0.0006) return;
  lastThemeP = p;

  // Text flips well ahead of the background so contrast never dies mid-gray.
  const tRaw = Math.min(1, Math.max(0, (p - 0.14) / 0.26));
  const t = tRaw < 0.5 ? 2 * tRaw * tRaw : 1 - Math.pow(-2 * tRaw + 2, 2) / 2;

  const s = docEl.style;
  s.setProperty('--tp', t.toFixed(4));
  for (const k in themePairs) s.setProperty(k, lerpC(themePairs[k][0], themePairs[k][1], t));
  themeMuted = lerpC(themePairs['--muted'][0], themePairs['--muted'][1], t);
  s.setProperty('--line', `rgba(${t < 0.5 ? '54,69,79' : '244,246,248'},${(0.22 + t * 0.02).toFixed(3)})`);
  s.setProperty('--ghost-stroke', `rgba(${t < 0.5 ? '54,69,79' : '255,255,255'},${(0.15 - t * 0.05).toFixed(3)})`);
  s.setProperty('--scrim-rgb', t < 0.5 ? '250,251,252' : '12,15,19');
  s.setProperty('--cta-glow-a', (Math.max(0, p - 0.6) / 0.4 * 0.5).toFixed(3));

  // Base plate under the studio backdrop.
  const bg = Math.round(255 * (1 - p));
  bgOverlay.style.background = `rgb(${bg},${bg},${Math.min(255, bg + 2)})`;

  // Standing-wave field: silent at the poles, present through the journey,
  // held gently at the finale so the ringing never fully stops.
  const mid = Math.sin(Math.min(1, Math.max(0, (p - 0.06) / 0.94)) * Math.PI);
  const finale = Math.max(0, (p - 0.82) / 0.18) * 0.5;
  ringField.style.opacity = (mid * 0.55 + finale * 0.45).toFixed(3);
  ringField.style.transform = `scale(${(1 + p * 0.3).toFixed(4)})`;
  ringField.style.setProperty('--ring-c', `rgba(${t < 0.5 ? '96,110,124' : '214,222,232'},${(0.04 + t * 0.025).toFixed(3)})`);
}
applyTheme(0);

/* ═══════════════════════════════════════════════════
   SCROLL STATE + MASTER CHOREOGRAPHY
   The journey: silence → rotation while the room goes
   dark → the instrument returns face-on, upright, for
   the strike. Spin ends at 2 full turns so the finale
   always faces the audience.
   ═══════════════════════════════════════════════════ */
const scrollState = { spinY: 0, tiltZ: 0, camAngle: 0, camY: 0, bgProgress: 0 };

if (!REDUCED) {
  const masterTL = gsap.timeline({
    scrollTrigger: { trigger: '#scroll-spacer', start: 'top top', end: 'bottom bottom', scrub: 1.2 }
  });
  masterTL
    .to(scrollState, { spinY: Math.PI * 4, duration: 5, ease: 'none' }, 0)
    .to(scrollState, { bgProgress: 1, duration: 4.0, ease: 'none' }, 0)
    .to(scrollState, { camAngle: Math.PI * 0.34, camY: -0.28, duration: 3.8, ease: 'sine.inOut' }, 0)
    .to(scrollState, { camAngle: 0, camY: 0.1, duration: 1.2, ease: 'power2.inOut' }, 3.8)
    .to(scrollState, { tiltZ: 22, duration: 2.1, ease: 'power1.inOut' }, 0)
    .to(scrollState, { tiltZ: 0, duration: 1.6, ease: 'power2.inOut' }, 3.4);
} else {
  // Reduced motion: no spin — a composed static pose; the room still
  // darkens with reading position (color, not motion).
  scrollState.spinY = -0.42;
  scrollState.tiltZ = 8;
  ScrollTrigger.create({
    trigger: '#scroll-spacer', start: 'top top', end: 'bottom bottom',
    onUpdate: (self) => { scrollState.bgProgress = self.progress; },
  });
}

/* ── Progress bar ─────────────────────────────── */
const progressBar = document.getElementById('progressBar');
ScrollTrigger.create({
  trigger: '#scroll-spacer', start: 'top top', end: 'bottom bottom',
  onUpdate: (self) => { progressBar.style.width = (self.progress * 100) + '%'; }
});

/* ── Scroll hint ──────────────────────────────── */
const scrollHint = document.getElementById('scrollHint');
window.addEventListener('scroll', () => { scrollHint.classList.toggle('hidden', window.scrollY > 80); }, { passive: true });

/* ═══════════════════════════════════════════════════
   CONTENT CHOREOGRAPHY
   Masked line reveals with stagger — played on entry,
   reversed on the way back up. Environment scrubs;
   language arrives with intent.
   ═══════════════════════════════════════════════════ */
const countUp = (el) => {
  const target = parseFloat(el.dataset.count);
  const suffix = el.dataset.suffix || '';
  const obj = { v: 0 };
  gsap.to(obj, {
    v: target, duration: 1.4, ease: 'power2.out', delay: 0.25,
    onUpdate: () => { el.textContent = Math.round(obj.v) + suffix; },
  });
};

let ctaRevealTl = null; // the finale's reveal — the strike waits for it

document.querySelectorAll('.content-panel').forEach((panel) => {
  const section = panel.closest('.content-section');
  const lines = panel.querySelectorAll('.tl-i');
  const rvs = panel.querySelectorAll('.rv');

  if (REDUCED) return; // CSS already forces visible states

  const tl = gsap.timeline({ paused: true });
  if (section.id === 'start') ctaRevealTl = tl;
  tl.to(lines, { y: 0, duration: 0.9, ease: 'power4.out', stagger: 0.09 }, 0)
    .to(rvs, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.07 }, 0.12);

  let counted = false;
  const arm = () => {
    section.classList.add('stats-live');
    tl.play();
    if (!counted) {
      counted = true;
      panel.querySelectorAll('[data-count]').forEach(countUp);
    }
  };

  if (section.id === 'hero') {
    // Load-in, not scroll-in.
    window.addEventListener('load', () => setTimeout(arm, 180), { once: true });
    setTimeout(arm, 900); // fallback if load already fired / hangs
  } else {
    ScrollTrigger.create({
      trigger: section,
      start: 'top 74%',
      onEnter: arm,
      onLeaveBack: () => { section.classList.remove('stats-live'); tl.reverse(); },
    });
  }
});

/* ── Ghost numerals drift slower than the page ── */
if (!REDUCED) {
  document.querySelectorAll('.ghost-num').forEach((el) => {
    gsap.fromTo(el, { yPercent: 26 }, {
      yPercent: -26, ease: 'none',
      scrollTrigger: { trigger: el.closest('.content-section'), start: 'top bottom', end: 'bottom top', scrub: 1.2 },
    });
  });
}

/* ── HUD yields to the footer ─────────────────── */
ScrollTrigger.create({
  trigger: '.site-footer',
  start: 'top 92%',
  onEnter: () => docEl.classList.add('footer-vis'),
  onLeaveBack: () => docEl.classList.remove('footer-vis'),
});

/* ── Active section in the nav ────────────────── */
const navLinks = {};
document.querySelectorAll('.nav-links a[data-nav]').forEach((a) => { navLinks[a.dataset.nav] = a; });
['visibility', 'automation', 'platform', 'start'].forEach((id) => {
  ScrollTrigger.create({
    trigger: '#' + id,
    start: 'top 55%', end: 'bottom 45%',
    onToggle: (self) => {
      if (navLinks[id]) navLinks[id].classList.toggle('active', self.isActive);
    },
  });
});

/* ═══════════════════════════════════════════════════
   INSTRUMENT HUD — tuner + phase-locking waveform
   The page tunes from A4♭ up to concert pitch: the Hz
   readout climbs with scroll and locks at 440.00; the
   two waveform traces (Visibility / Automation) drift
   into phase and become one wave at the finale.
   ═══════════════════════════════════════════════════ */
const hud = document.getElementById('hud');
const hudHz = document.getElementById('hudHz');
const hudState = document.getElementById('hudState');
const waveCanvas = document.getElementById('wave-canvas');
const waveCtx = waveCanvas ? waveCanvas.getContext('2d') : null;
let waveW = 156, waveH = 36;

function sizeWave() {
  if (!waveCanvas) return;
  const dpr = Math.min(window.devicePixelRatio, 2);
  waveCanvas.width = waveW * dpr;
  waveCanvas.height = waveH * dpr;
  waveCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
}
sizeWave();

let smoothVel = 0;
let waveInk = 'rgb(112,128,144)';
let lastScrollY = window.scrollY;

function drawWave(time, p, strikeEnv) {
  if (!waveCtx) return;
  waveCtx.clearRect(0, 0, waveW, waveH);

  const mid = waveH / 2;
  const phaseGap = (1 - p) * 2.2;           // traces drift into unison
  const locked = phaseGap < 0.08;
  const amp = 4.5 + Math.min(9, smoothVel * 6) + strikeEnv * 9;
  const freq = (Math.PI * 2 * 2.4) / waveW;

  const trace = (phase, alpha, width) => {
    waveCtx.beginPath();
    for (let x = 0; x <= waveW; x += 2) {
      const decay = strikeEnv > 0.01 ? 1 : 0.35 + 0.65 * Math.sin((x / waveW) * Math.PI);
      const y = mid + Math.sin(x * freq + time * 2.1 + phase) * amp * decay * 0.5;
      x === 0 ? waveCtx.moveTo(x, y) : waveCtx.lineTo(x, y);
    }
    waveCtx.globalAlpha = alpha;
    waveCtx.lineWidth = width;
    waveCtx.strokeStyle = waveInk;
    waveCtx.stroke();
    waveCtx.globalAlpha = 1;
  };

  if (locked) {
    trace(0, 0.95, 1.6);
  } else {
    trace(0, 0.8, 1.1);
    trace(phaseGap, 0.5, 1.1);
  }
}

function updateHud(time, p, strikeEnv, striking) {
  // 415.30 Hz (A♭4) → 440.00 Hz (A4, concert pitch).
  // The needle may hesitate but never dips below where it started:
  // this page only ever tunes UP.
  const wander = REDUCED ? 0 : Math.sin(time * 0.9) * 0.6 * (1 - p) + Math.sin(time * 2.3) * 0.25 * (1 - p);
  const hz = Math.max(415.3, 415.3 + 24.7 * p + wander);
  hudHz.textContent = hz.toFixed(2) + ' Hz';

  const inTune = p > 0.965;
  hud.classList.toggle('in-tune', inTune);
  hudState.textContent = striking ? 'Ringing' : (inTune ? 'In tune' : 'Flat');

  if (!REDUCED) drawWave(time, p, strikeEnv);
}

if (REDUCED && waveCtx) {
  // One calm, locked trace — no animation.
  smoothVel = 0;
  drawWave(0, 1, 0);
}

/* ═══════════════════════════════════════════════════
   RENDERER + SCENE  (skipped entirely without WebGL)
   ═══════════════════════════════════════════════════ */
if (!renderer) {
  // DOM-only fallback: theme + HUD still track scroll.
  gsap.ticker.add(() => {
    applyTheme(scrollState.bgProgress);
    updateHud(performance.now() / 1000, scrollState.bgProgress, 0, false);
  });
  return;
}

const container = document.getElementById('canvas-container');
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(38, window.innerWidth / window.innerHeight, 0.1, 100);

const DPR_CAP = COARSE ? 1.75 : 2;
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, DPR_CAP));
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;
renderer.outputEncoding = THREE.sRGBEncoding;
renderer.setClearColor(0x000000, 0);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
container.appendChild(renderer.domElement);

/* ═══════════════════════════════════════════════════
   POST-PROCESSING RIPPLE SHADER
   ═══════════════════════════════════════════════════ */
const renderTarget = new THREE.WebGLRenderTarget(
  window.innerWidth * Math.min(window.devicePixelRatio, DPR_CAP),
  window.innerHeight * Math.min(window.devicePixelRatio, DPR_CAP)
);

const rippleShaderMat = new THREE.ShaderMaterial({
  uniforms: {
    tDiffuse:    { value: null },
    uTime:       { value: 0.0 },
    uIntensity:  { value: 0.0 },
    uCenter:     { value: new THREE.Vector2(0.5, 0.5) },
  },
  vertexShader: `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform sampler2D tDiffuse;
    uniform float uTime;
    uniform float uIntensity;
    uniform vec2 uCenter;
    varying vec2 vUv;

    void main() {
      vec2 uv = vUv;
      vec2 toCenter = uv - uCenter;
      float dist = length(toCenter);
      vec2 dir = normalize(toCenter + 0.0001);

      // Multiple expanding ripple rings
      float ripple = 0.0;
      for (float i = 0.0; i < 4.0; i++) {
        float ringSpeed = 0.35 + i * 0.08;
        float ringRadius = uTime * ringSpeed;
        float ringDist = abs(dist - ringRadius);
        // Sine wave that's strong near the ring and fades away
        float wave = sin(ringDist * 60.0) * exp(-ringDist * 12.0);
        // Fade ring as it expands
        float ringFade = exp(-ringRadius * 1.5);
        ripple += wave * ringFade;
      }

      // Displace UV along radial direction
      uv += dir * ripple * uIntensity * 0.04;

      gl_FragColor = texture2D(tDiffuse, uv);
    }
  `,
  depthTest: false,
  depthWrite: false,
});

const quadGeo = new THREE.PlaneGeometry(2, 2);
const quadMesh = new THREE.Mesh(quadGeo, rippleShaderMat);
const postScene = new THREE.Scene();
const postCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
postScene.add(quadMesh);

/* ═══════════════════════════════════════════════════
   RIPPLE CANVAS (2D overlay)
   ═══════════════════════════════════════════════════ */
const rippleCanvas = document.getElementById('ripple-canvas');
const rippleCtx    = rippleCanvas.getContext('2d');

function sizeRippleCanvas() {
  rippleCanvas.width  = window.innerWidth * window.devicePixelRatio;
  rippleCanvas.height = window.innerHeight * window.devicePixelRatio;
  rippleCanvas.style.width  = window.innerWidth + 'px';
  rippleCanvas.style.height = window.innerHeight + 'px';
  rippleCtx.setTransform(1, 0, 0, 1, 0, 0); // reset before scaling
  rippleCtx.scale(window.devicePixelRatio, window.devicePixelRatio);
}
sizeRippleCanvas();

/* ═══════════════════════════════════════════════════
   LIGHTING
   ═══════════════════════════════════════════════════ */
const ambientLight = new THREE.AmbientLight(0xffffff, 0.22);
scene.add(ambientLight);

const keyLight = new THREE.DirectionalLight(0xfff4e6, 1.1);
keyLight.position.set(3, 7, 5);
keyLight.castShadow = true;
keyLight.shadow.mapSize.set(2048, 2048);
keyLight.shadow.camera.left = -3;
keyLight.shadow.camera.right = 3;
keyLight.shadow.camera.top = 5;
keyLight.shadow.camera.bottom = -5;
keyLight.shadow.camera.near = 0.5;
keyLight.shadow.camera.far = 30;
keyLight.shadow.bias = -0.0002;
keyLight.shadow.radius = 4;
scene.add(keyLight);

const fillLight = new THREE.DirectionalLight(0xc8d4ee, 0.5);
fillLight.position.set(-5, 3, -3);
scene.add(fillLight);

const rimLight = new THREE.DirectionalLight(0xffffff, 0.85);
rimLight.position.set(-1, -2, -6);
scene.add(rimLight);

const rimLight2 = new THREE.DirectionalLight(0xdfe8f4, 0.0);
rimLight2.position.set(2.5, 1.5, -5);
scene.add(rimLight2);

const topLight = new THREE.DirectionalLight(0xeaf0ff, 0.32);
topLight.position.set(0, 12, 0);
scene.add(topLight);

const frontFill = new THREE.PointLight(0xffe8d0, 0.2, 20);
frontFill.position.set(0, 1, 8);
scene.add(frontFill);

/* ═══════════════════════════════════════════════════
   ENVIRONMENT MAP — studio-photography envScene
   prefiltered through PMREMGenerator so PBR roughness
   gets proper mip-blurred reflections.

   The horizon band is deliberately BRIGHT: a vertical
   polished tube reflects mostly horizon, and a dark
   horizon is what made the fork read as a silhouette.
   ═══════════════════════════════════════════════════ */
const envScene = new THREE.Scene();

// PMREM-safe materials ONLY in here. The previous ShaderMaterial sky and
// softboxes rendered BLACK through PMREMGenerator in r128 — the metal was
// reflecting an empty room, which is why the fork read as a silhouette.
// Vertex-colored basic materials capture correctly.
const skyGeo = new THREE.SphereGeometry(80, 64, 64);
{
  // Bright studio walls at eye level, soft daylight above, darker implied
  // floor below. A vertical polished tube reflects mostly horizon, so the
  // horizon band is deliberately bright.
  const skyPos = skyGeo.attributes.position;
  const skyCols = new Float32Array(skyPos.count * 3);
  for (let i = 0; i < skyPos.count; i++) {
    const y = skyPos.getY(i) / 80;
    const top = Math.min(1, Math.max(0, (y + 0.08) / 0.68));
    let r = 0.52 + (0.85 - 0.52) * top;
    let g = 0.53 + (0.86 - 0.53) * top;
    let b = 0.57 + (0.90 - 0.57) * top;
    if (y < 0) {
      const f = Math.min(1, -y * 1.6);
      r += (0.10 - r) * f; g += (0.10 - g) * f; b += (0.13 - b) * f;
    }
    skyCols[i * 3] = r; skyCols[i * 3 + 1] = g; skyCols[i * 3 + 2] = b;
  }
  skyGeo.setAttribute('color', new THREE.BufferAttribute(skyCols, 3));
}
envScene.add(new THREE.Mesh(skyGeo, new THREE.MeshBasicMaterial({ vertexColors: true, side: THREE.BackSide })));

// Studio softbox panels — bright rectangular sources produce the
// recognizable elongated highlights that read as "polished metal."
const softboxes = [
  { pos: [ 11,  13,   8], size: [10,  7, 0.4], color: [1.75, 1.7, 1.6]  }, // warm key, above-front-right
  { pos: [ -9,   9,   6], size: [ 8,  6, 0.4], color: [1.15, 1.2, 1.42] }, // cool fill, above-front-left
  { pos: [  0,  17,   0], size: [ 9,  9, 0.4], color: [1.45, 1.5, 1.65] }, // skylight overhead
  { pos: [  4,  -2, -10], size: [ 5,  4, 0.4], color: [1.55, 1.15, 0.8] }, // warm rim, behind-below
  { pos: [ -3,   0,  11], size: [12,  3, 0.4], color: [1.3, 1.32, 1.4]  }, // long front strip at tube height
];
softboxes.forEach(({ pos, size, color }) => {
  const m = new THREE.Mesh(
    new THREE.BoxGeometry(...size),
    new THREE.MeshBasicMaterial({ color: new THREE.Color().fromArray(color) })
  );
  m.position.set(...pos);
  m.lookAt(0, 0, 0);
  envScene.add(m);
});

// Scattered subtle spec hits — break up the otherwise empty sky
for (let i = 0; i < 14; i++) {
  const ang = (i / 14) * Math.PI * 2 + Math.random() * 0.3;
  const r = 22 + Math.random() * 18;
  const y = -10 + Math.random() * 28;
  const b = 0.6 + Math.random() * 0.5;
  const m = new THREE.Mesh(
    new THREE.SphereGeometry(0.4 + Math.random() * 0.7, 8, 8),
    new THREE.MeshBasicMaterial({ color: new THREE.Color(b, b, b * (0.9 + Math.random() * 0.2)) })
  );
  m.position.set(Math.cos(ang) * r, y, Math.sin(ang) * r);
  envScene.add(m);
}

const pmremGen = new THREE.PMREMGenerator(renderer);
pmremGen.compileEquirectangularShader();
const envTexture = pmremGen.fromScene(envScene, 0.04, 0.1, 200).texture;
pmremGen.dispose();

// Back-compat shim: existing material declarations reference cubeRT.texture.
const cubeRT = { texture: envTexture };

/* ═══════════════════════════════════════════════════
   MATERIALS
   ═══════════════════════════════════════════════════ */
// Procedural brushed-metal roughness map: lengthwise micro-scratches +
// gentle blotches break up reflections so the fork reads as polished
// instrument steel, not a chrome ball.
function makeBrushedMetalRoughnessMap() {
  const c = document.createElement('canvas');
  c.width = 1024; c.height = 1024;
  const ctx = c.getContext('2d');
  ctx.fillStyle = '#9b9ba0'; // base ~0.6 roughness, modulated by material's roughness slider
  ctx.fillRect(0, 0, 1024, 1024);
  ctx.globalAlpha = 0.06;
  ctx.lineWidth = 1;
  for (let i = 0; i < 6500; i++) {
    const y = Math.random() * 1024;
    const x = Math.random() * 1024;
    const len = 80 + Math.random() * 320;
    const v = 70 + Math.random() * 90;
    ctx.strokeStyle = `rgb(${v},${v},${v})`;
    ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x + len, y); ctx.stroke();
  }
  ctx.globalAlpha = 0.025;
  for (let i = 0; i < 280; i++) {
    const x = Math.random() * 1024;
    const y = Math.random() * 1024;
    const r = 6 + Math.random() * 28;
    const v = 90 + Math.random() * 50;
    ctx.fillStyle = `rgb(${v|0},${v|0},${v|0})`;
    ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
  }
  const tex = new THREE.CanvasTexture(c);
  tex.wrapS = THREE.RepeatWrapping;
  tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(2, 6); // stretch lengthwise — brushing direction along the bar
  tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
  return tex;
}

const roughnessTex = makeBrushedMetalRoughnessMap();

// Tines + U-bend: satin instrument steel with light clearcoat.
// Roughness keeps a floor so the metal always shows brushed body
// instead of collapsing into a dark mirror.
const silverMat = new THREE.MeshPhysicalMaterial({
  color: 0xe9e9ee,
  metalness: 0.96,
  roughness: 0.24,
  roughnessMap: roughnessTex,
  envMap: cubeRT.texture,
  envMapIntensity: 1.15,
  clearcoat: 0.5,
  clearcoatRoughness: 0.08,
});

// Grip rings: more matte for tactile contrast against the polished bar.
const gripMat = new THREE.MeshPhysicalMaterial({
  color: 0xb2b2b8,
  metalness: 0.85,
  roughness: 0.55,
  roughnessMap: roughnessTex,
  envMap: cubeRT.texture,
  envMapIntensity: 0.8,
  clearcoat: 0.15,
  clearcoatRoughness: 0.4,
});

/* ═══════════════════════════════════════════════════
   HIGH-FIDELITY TUNING FORK
   ═══════════════════════════════════════════════════ */
const forkGroup = new THREE.Group();
const SEG = 64;
const V3 = THREE.Vector3;

const prongSep   = 0.30;
const prongH     = 3.2;
const tubeR      = 0.082;
const handleLen  = 3.4;

/* ── Fork head: U-bend + prongs as one tube ──── */
const curvePts = [];
const leftX  = -prongSep;
const rightX = prongSep;
const uTop   = prongSep;
const tipY   = uTop + prongH;

for (let i = 0; i <= 12; i++) {
  curvePts.push(new V3(leftX, tipY - (i/12) * prongH, 0));
}

const uSteps = 24;
for (let i = 1; i < uSteps; i++) {
  const theta = Math.PI * (i / uSteps);
  curvePts.push(new V3(-prongSep * Math.cos(theta), prongSep - prongSep * Math.sin(theta), 0));
}

for (let i = 0; i <= 12; i++) {
  curvePts.push(new V3(rightX, uTop + (i/12) * prongH, 0));
}

const forkCurve = new THREE.CatmullRomCurve3(curvePts, false, 'centripetal', 0.3);
const tubeGeo = new THREE.TubeGeometry(forkCurve, 256, tubeR, 32, false);
tubeGeo.computeVertexNormals();

// Taper prong tips
const positions = tubeGeo.attributes.position;
for (let i = 0; i < positions.count; i++) {
  const px = positions.getX(i);
  const py = positions.getY(i);
  const pz = positions.getZ(i);

  const distL = Math.sqrt((px-leftX)**2 + (py-tipY)**2 + pz**2);
  const distR = Math.sqrt((px-rightX)**2 + (py-tipY)**2 + pz**2);

  if (Math.min(distL,distR) < 0.6) {
    const cx = distL < distR ? leftX : rightX;
    const radial = new V3(px - cx, 0, pz);
    const rLen = radial.length();
    if (rLen > 0.001 && py > tipY - 0.6) {
      const prox = Math.max(0, Math.min(1, (tipY - py) / 0.55));
      const s = Math.sqrt(prox);
      const nr = radial.normalize().multiplyScalar(rLen * s);
      positions.setX(i, cx + nr.x);
      positions.setZ(i, nr.z);
    }
  }
}
positions.needsUpdate = true;
tubeGeo.computeVertexNormals();

// Store original positions for vibration effect
const origPositions = new Float32Array(positions.array);

const forkHead = new THREE.Mesh(tubeGeo, silverMat);
forkGroup.add(forkHead);

/* ── Tip caps ─────────────────────────────────── */
const tipCapGeo = new THREE.SphereGeometry(tubeR * 0.35, 32, 16);
[leftX, rightX].forEach(x => {
  const cap = new THREE.Mesh(tipCapGeo, silverMat);
  cap.position.set(x, tipY + 0.01, 0);
  forkGroup.add(cap);
});

/* ── Handle ───────────────────────────────────── */
const handleProfile = [];
const hSteps = 100;
const handleBottom = -handleLen;

for (let i = 0; i <= hSteps; i++) {
  const t = i / hSteps;
  const y = handleBottom + t * handleLen;
  let r;
  if (t < 0.015) {
    const s = t / 0.015;
    r = 0.005 + Math.sqrt(1-(1-s)*(1-s)) * 0.13;
  } else if (t < 0.06) {
    const s = (t-0.015)/0.045; const e = 3*s*s-2*s*s*s;
    r = 0.135 + e * 0.015;
  } else if (t < 0.55) {
    r = 0.15 - ((t-0.06)/0.49) * 0.012;
  } else if (t < 0.68) {
    const s = (t-0.55)/0.13; const e = 3*s*s-2*s*s*s;
    r = 0.138 - e * 0.02;
  } else if (t < 0.88) {
    r = 0.118 + ((t-0.68)/0.20) * 0.01;
  } else {
    const s = (t-0.88)/0.12; const e = 3*s*s-2*s*s*s;
    r = 0.128 + e * (tubeR - 0.038);
  }
  handleProfile.push(new THREE.Vector2(Math.max(r, 0.001), y));
}

const handleGeo = new THREE.LatheGeometry(handleProfile, SEG);
handleGeo.computeVertexNormals();
const handleMesh = new THREE.Mesh(handleGeo, silverMat);
forkGroup.add(handleMesh);

/* ── Grip rings ───────────────────────────────── */
const gripStart = handleBottom + handleLen * 0.08;
const gripEnd   = handleBottom + handleLen * 0.52;

for (let i = 0; i < 28; i++) {
  const t = i / 27;
  const y = gripStart + t * (gripEnd - gripStart);
  const pT = (y - handleBottom) / handleLen;
  const rA = 0.148 - (pT - 0.06) * 0.012 / 0.49;
  const ring = new THREE.Mesh(new THREE.TorusGeometry(rA+0.003, 0.006, 8, SEG), gripMat);
  ring.position.y = y; ring.rotation.x = Math.PI/2;
  forkGroup.add(ring);
}

[gripStart-0.02, gripEnd+0.02].forEach(y => {
  const band = new THREE.Mesh(new THREE.TorusGeometry(0.152, 0.012, 12, SEG), silverMat);
  band.position.y = y; band.rotation.x = Math.PI/2;
  forkGroup.add(band);
});

/* ── Collar ───────────────────────────────────── */
const collar = new THREE.Mesh(new THREE.TorusGeometry(tubeR+0.06, 0.018, 16, SEG), silverMat);
collar.position.y = 0.01; collar.rotation.x = Math.PI/2;
forkGroup.add(collar);

/* ── Cast shadows ─────────────────────────────── */
forkGroup.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });

/* ── Frame the whole instrument ───────────────── */
// Slightly scaled down + camera pulled back so the tips live inside the
// frame at the hero instead of cropping into a smear at the top edge.
forkGroup.scale.setScalar(0.88);
const bbox = new THREE.Box3().setFromObject(forkGroup);
const centerY = (bbox.min.y + bbox.max.y) / 2;
forkGroup.position.y = -centerY;
scene.add(forkGroup);

/* ── Contact shadow plane ─────────────────────── */
// Invisible plane that only renders the shadow falling onto it. Grounds
// the fork without introducing a visible floor.
const contactFloor = new THREE.Mesh(
  new THREE.PlaneGeometry(20, 20),
  new THREE.ShadowMaterial({ opacity: 0.22 })
);
contactFloor.rotation.x = -Math.PI / 2;
contactFloor.position.y = bbox.min.y - centerY - 0.02;
contactFloor.receiveShadow = true;
scene.add(contactFloor);

/* ═══════════════════════════════════════════════════
   CAMERA
   ═══════════════════════════════════════════════════ */
const camDist = COARSE ? 11.0 : 9.7;
camera.position.set(0, 0, camDist);
camera.lookAt(0, 0, 0);

/* ═══════════════════════════════════════════════════
   POINTER — the instrument leans with you, and a
   click anywhere on it strikes the fork.
   ═══════════════════════════════════════════════════ */
const pointer = { x: 0, y: 0, tx: 0, ty: 0, overFork: false };
const raycaster = new THREE.Raycaster();
const pointerNDC = new THREE.Vector2();

// Generous invisible hit volume: aiming "at the instrument" should count,
// including the air between the tines.
const hitProxy = new THREE.Mesh(
  new THREE.CylinderGeometry(prongSep + 0.32, 0.3, tipY - handleBottom + 0.6, 12),
  new THREE.MeshBasicMaterial({ visible: false })
);
hitProxy.position.y = (tipY + handleBottom) / 2;
forkGroup.add(hitProxy);
const forkMeshes = [forkHead, handleMesh, hitProxy];

if (!REDUCED && !COARSE) {
  window.addEventListener('pointermove', (e) => {
    pointer.tx = (e.clientX / window.innerWidth) * 2 - 1;
    pointer.ty = (e.clientY / window.innerHeight) * 2 - 1;
    pointerNDC.set(pointer.tx, -pointer.ty);
    raycaster.setFromCamera(pointerNDC, camera);
    const hit = raycaster.intersectObjects(forkMeshes, false).length > 0;
    if (hit !== pointer.overFork) {
      pointer.overFork = hit;
      document.body.style.cursor = hit ? 'pointer' : '';
    }
  }, { passive: true });
}

let lastStrikeAt = -10;
window.addEventListener('pointerdown', (e) => {
  if (REDUCED) return;
  if (e.target.closest('a, button, nav, .content-panel, footer')) return;
  pointerNDC.set((e.clientX / window.innerWidth) * 2 - 1, -((e.clientY / window.innerHeight) * 2 - 1));
  raycaster.setFromCamera(pointerNDC, camera);
  if (raycaster.intersectObjects(forkMeshes, false).length > 0) {
    const now = performance.now() / 1000;
    if (now - lastStrikeAt > 2.2) fireStrike();
  }
});

/* ═══════════════════════════════════════════════════
   STRIKE EFFECT SYSTEM
   Fires once as the finale enters — and again any
   time the visitor strikes the instrument directly.
   ═══════════════════════════════════════════════════ */
let strikeActive   = false;
let strikeTime     = 0;      // seconds since strike
let afterglow      = false;  // "still ringing" state after first strike

const STRIKE_DURATION  = 6.0;  // total effect duration in seconds
const VIBRATION_FREQ   = 28;   // Hz — vibration frequency of prongs
const VIBRATION_AMP    = 0.12; // max lateral displacement
const RIPPLE_COUNT     = 10;   // number of expanding rings per pole
const RIPPLE_SPEED     = 600;  // pixels per second expansion rate
const RIPPLE_INTERVAL  = 0.12; // seconds between successive ring births

// Post-process ripple state
let usePostRipple = false;

// DOM elements to apply SVG ripple filter to
const domRippleEls = [];
const domDisplace = document.getElementById('dom-displace');
const domTurb = document.getElementById('dom-turb');

function fireStrike() {
  lastStrikeAt = performance.now() / 1000;
  strikeActive = true;
  strikeTime = 0;
  usePostRipple = true;
  if (domRippleEls.length === 0) {
    // Wiggle children of panels — never the GSAP-animated panel itself,
    // whose transform belongs to the reveal timeline.
    document.querySelectorAll('.content-panel > *, nav, .scroll-hint, .hud').forEach(el => {
      el.style.filter = 'url(#dom-ripple)';
      el.style.willChange = 'filter';
      domRippleEls.push(el);
    });
  }
}

// The crescendo: the room is dark, the instrument faces you, the final
// words land — then one held breath of silence, and the strike.
// (A crescendo needs the rest before the downbeat.)
let autoStruck = false;
let pendingStrike = null;
ScrollTrigger.create({
  trigger: '#start',
  start: 'top 60%',
  onEnter: () => {
    if (REDUCED || autoStruck || pendingStrike) return;
    const remaining = ctaRevealTl ? Math.max(0, ctaRevealTl.duration() - ctaRevealTl.time()) : 0;
    pendingStrike = gsap.delayedCall(remaining + 0.45, () => {
      autoStruck = true;
      pendingStrike = null;
      fireStrike();
    });
  },
  // Scrolled back out before the beat landed: cancel, re-arm on next entry.
  onLeaveBack: () => {
    if (pendingStrike) { pendingStrike.kill(); pendingStrike = null; }
  },
});

/* ── Project 3D point to 2D screen coords ─────── */
function projectToScreen(worldPos) {
  const v = worldPos.clone().project(camera);
  return {
    x: (v.x * 0.5 + 0.5) * window.innerWidth,
    y: (-v.y * 0.5 + 0.5) * window.innerHeight,
  };
}

/* ── Get current world positions of prong tips ── */
function getProngTipWorldPositions() {
  // Local positions of tips (before forkGroup transforms)
  const localLeft  = new V3(leftX, tipY, 0);
  const localRight = new V3(rightX, tipY, 0);

  // Apply forkGroup's world matrix
  forkGroup.updateMatrixWorld(true);
  const wl = localLeft.clone().applyMatrix4(forkGroup.matrixWorld);
  const wr = localRight.clone().applyMatrix4(forkGroup.matrixWorld);
  return [wl, wr];
}

/* ── Draw ripple rings on 2D canvas ───────────── */
function drawRipples(dt, now) {
  rippleCtx.clearRect(0, 0, window.innerWidth, window.innerHeight);

  const W = window.innerWidth;
  const H = window.innerHeight;

  // Afterglow: once struck, the instrument never fully falls silent —
  // slow, faint rings keep breathing outward from the tips.
  if (afterglow && !strikeActive && !REDUCED && scrollState.bgProgress > 0.5) {
    const [wl, wr] = getProngTipWorldPositions();
    const sL = projectToScreen(wl);
    const sR = projectToScreen(wr);
    const cx = (sL.x + sR.x) / 2;
    const cy = (sL.y + sR.y) / 2;
    for (let k = 0; k < 2; k++) {
      const phase = ((now * 0.22 + k * 0.5) % 1);
      const radius = 30 + phase * 420;
      const alpha = (1 - phase) * 0.05;
      rippleCtx.beginPath();
      rippleCtx.arc(cx, cy, radius, 0, Math.PI * 2);
      rippleCtx.strokeStyle = `rgba(226,230,240,${alpha.toFixed(3)})`;
      rippleCtx.lineWidth = 1;
      rippleCtx.stroke();
    }
  }

  if (!strikeActive) return;

  const [wl, wr] = getProngTipWorldPositions();
  const screenL = projectToScreen(wl);
  const screenR = projectToScreen(wr);

  // Overall envelope: sharp attack, slow decay
  const envelope = strikeTime < 0.12
    ? strikeTime / 0.12
    : Math.max(0, 1 - (strikeTime - 0.12) / (STRIKE_DURATION - 0.12));
  const env2 = envelope * envelope;

  // ── Epicenter: fork midpoint on screen (used by all effects below) ──
  const epicenterX = (screenL.x + screenR.x) / 2;
  const epicenterY = (screenL.y + screenR.y) / 2;

  // ── SHOCKWAVE PULSE from fork epicenter ─────
  if (strikeTime < 0.3) {
    const blastA = Math.max(0, 1 - strikeTime / 0.3) * 0.4;
    const blastR = 80 + strikeTime * 2500; // rapidly expanding flash
    const grad = rippleCtx.createRadialGradient(epicenterX, epicenterY, 0, epicenterX, epicenterY, blastR);
    grad.addColorStop(0, `rgba(255,255,255,${blastA})`);
    grad.addColorStop(0.2, `rgba(240,240,255,${blastA * 0.7})`);
    grad.addColorStop(0.5, `rgba(220,220,240,${blastA * 0.3})`);
    grad.addColorStop(1, `rgba(200,200,220,0)`);
    rippleCtx.fillStyle = grad;
    rippleCtx.fillRect(0, 0, W, H);
  }

  // Lingering screen-wide pulsing distortion — emanates from fork midpoint
  if (strikeTime < 3.0) {
    const pulsePhase = Math.sin(strikeTime * VIBRATION_FREQ * Math.PI * 2);
    const pulseDecay = Math.max(0, 1 - strikeTime / 3.0);
    const pulseA = pulseDecay * pulseDecay * Math.abs(pulsePhase) * 0.07;
    const grad = rippleCtx.createRadialGradient(epicenterX, epicenterY, 0, epicenterX, epicenterY, Math.max(W, H) * 0.7);
    grad.addColorStop(0, `rgba(255,255,255,${pulseA * 0.5})`);
    grad.addColorStop(0.3, `rgba(220,220,240,${pulseA})`);
    grad.addColorStop(0.7, `rgba(200,200,220,${pulseA * 0.6})`);
    grad.addColorStop(1, `rgba(180,180,200,0)`);
    rippleCtx.fillStyle = grad;
    rippleCtx.fillRect(0, 0, W, H);
  }

  // ── FLASH at each pole ──────────────────────
  if (strikeTime < 0.8) {
    const flashA = Math.max(0, 1 - strikeTime / 0.8);
    [screenL, screenR].forEach(pole => {
      const r1 = 150 + strikeTime * 250;
      const grad = rippleCtx.createRadialGradient(pole.x, pole.y, 0, pole.x, pole.y, r1);
      grad.addColorStop(0, `rgba(255,255,255,${flashA * 0.85})`);
      grad.addColorStop(0.1, `rgba(240,240,255,${flashA * 0.6})`);
      grad.addColorStop(0.3, `rgba(200,200,230,${flashA * 0.25})`);
      grad.addColorStop(0.6, `rgba(180,180,210,${flashA * 0.08})`);
      grad.addColorStop(1, `rgba(180,180,200,0)`);
      rippleCtx.fillStyle = grad;
      rippleCtx.beginPath();
      rippleCtx.arc(pole.x, pole.y, r1, 0, Math.PI * 2);
      rippleCtx.fill();
    });
  }

  // ── EXPANDING SHOCKWAVE RING (single massive ring from epicenter) ──
  if (strikeTime > 0.05 && strikeTime < 2.5) {
    const shockAge = strikeTime - 0.05;
    const shockR = shockAge * 800;
    const shockA = Math.max(0, 1 - shockAge / 2.5) * 0.4;
    rippleCtx.beginPath();
    rippleCtx.arc(epicenterX, epicenterY, shockR, 0, Math.PI * 2);
    rippleCtx.strokeStyle = `rgba(255,255,255,${shockA})`;
    rippleCtx.lineWidth = Math.max(2, 12 - shockAge * 4);
    rippleCtx.stroke();
    // Thick glow behind shockwave
    rippleCtx.beginPath();
    rippleCtx.arc(epicenterX, epicenterY, shockR, 0, Math.PI * 2);
    rippleCtx.strokeStyle = `rgba(200,200,230,${shockA * 0.3})`;
    rippleCtx.lineWidth = Math.max(4, 40 - shockAge * 15);
    rippleCtx.stroke();
  }

  // ── Expanding ripple rings ─────────────────
  [screenL, screenR].forEach((pole) => {
    for (let r = 0; r < RIPPLE_COUNT; r++) {
      const birthTime = r * RIPPLE_INTERVAL;
      const age = strikeTime - birthTime;
      if (age < 0) continue;

      // Rings decelerate as they expand (sqrt curve)
      const radius = Math.sqrt(age) * RIPPLE_SPEED * 0.65;
      const ringLife = age / (STRIKE_DURATION - birthTime);
      const ringAlpha = Math.max(0, (1 - ringLife * 1.2)) * env2;

      if (ringAlpha < 0.003) continue;

      // Primary ring — bold and bright
      const lw = Math.max(1.0, 3.5 - radius * 0.002);
      rippleCtx.beginPath();
      rippleCtx.arc(pole.x, pole.y, radius, 0, Math.PI * 2);
      rippleCtx.strokeStyle = `rgba(230,230,245,${ringAlpha * 0.7})`;
      rippleCtx.lineWidth = lw;
      rippleCtx.stroke();

      // Wide glow halo behind the ring
      if (ringAlpha > 0.03) {
        rippleCtx.beginPath();
        rippleCtx.arc(pole.x, pole.y, radius, 0, Math.PI * 2);
        rippleCtx.strokeStyle = `rgba(210,210,235,${ringAlpha * 0.2})`;
        rippleCtx.lineWidth = lw * 10;
        rippleCtx.stroke();
      }

      // Ghost ring
      if (r % 2 === 0 && ringAlpha > 0.05) {
        rippleCtx.beginPath();
        rippleCtx.arc(pole.x, pole.y, radius * 1.04, 0, Math.PI * 2);
        rippleCtx.strokeStyle = `rgba(240,240,255,${ringAlpha * 0.25})`;
        rippleCtx.lineWidth = lw * 0.7;
        rippleCtx.stroke();
      }
    }
  });

  // ── Interference pattern where rings from both poles overlap ──
  if (strikeTime > 0.2 && strikeTime < 4.5) {
    const intA = Math.min(1, (strikeTime - 0.2) / 0.4) * Math.max(0, 1 - (strikeTime - 0.2) / 4.0);
    // Pulsing interference — beats between the two wave sources
    const beat = Math.sin(strikeTime * 12) * 0.5 + 0.5;
    const intR = 60 + strikeTime * 80;
    const grad = rippleCtx.createRadialGradient(epicenterX, epicenterY, 0, epicenterX, epicenterY, intR);
    grad.addColorStop(0, `rgba(255,255,255,${intA * beat * 0.35})`);
    grad.addColorStop(0.3, `rgba(220,220,240,${intA * beat * 0.15})`);
    grad.addColorStop(0.7, `rgba(200,200,225,${intA * 0.05})`);
    grad.addColorStop(1, `rgba(200,200,225,0)`);
    rippleCtx.fillStyle = grad;
    rippleCtx.beginPath();
    rippleCtx.arc(epicenterX, epicenterY, intR, 0, Math.PI * 2);
    rippleCtx.fill();
  }
}

/* ── Vibrate prong vertices ───────────────────── */
function vibrateProng() {
  if (!strikeActive) return;

  // Decay envelope for vibration
  const decay = Math.exp(-strikeTime * 1.2);
  const amp = VIBRATION_AMP * decay;

  if (amp < 0.0002) {
    // Vibration is negligible — restore and let the ripples finish out
    positions.array.set(origPositions);
    positions.needsUpdate = true;
    tubeGeo.computeVertexNormals();
    return;
  }

  const phase = strikeTime * VIBRATION_FREQ * Math.PI * 2;

  for (let i = 0; i < positions.count; i++) {
    const origX = origPositions[i * 3];
    const origY = origPositions[i * 3 + 1];

    // Only vibrate vertices in the prong region (above U-bend)
    if (origY > uTop - 0.05) {
      // How far up the prong (0 at base, 1 at tip) — more displacement at tips
      const prongT = Math.max(0, Math.min(1, (origY - uTop) / prongH));
      // Cubic ramp: tips move most
      const influence = prongT * prongT * prongT;

      // Left prong moves +X, right prong moves -X (opposite phase, like real fork)
      const side = origX < 0 ? 1 : -1;
      const displacement = Math.sin(phase) * amp * influence * side;

      positions.setX(i, origX + displacement);
    } else {
      // Below prongs — keep original
      positions.setX(i, origX);
    }
  }

  positions.needsUpdate = true;
  tubeGeo.computeVertexNormals();
}

/* ═══════════════════════════════════════════════════
   RENDER LOOP
   ═══════════════════════════════════════════════════ */
const ctaBtn = document.getElementById('ctaBtn');
let lastTime = performance.now();
let strikeEnvSmoothed = 0;
let frameN = 0;
let ringX = 50, ringY = 42;

function animate() {
  requestAnimationFrame(animate);

  const nowMs = performance.now();
  const dt = Math.min(0.05, (nowMs - lastTime) / 1000);
  lastTime = nowMs;
  const now = nowMs / 1000;

  const p = scrollState.bgProgress;

  /* ── Theme: one write-through of CSS custom props ── */
  applyTheme(p);

  /* ── Scroll velocity (for the waveform's liveliness) ── */
  const rawVel = lenis ? Math.abs(lenis.velocity) / 60 : Math.abs(window.scrollY - lastScrollY) / 14;
  lastScrollY = window.scrollY;
  smoothVel += (Math.min(2.2, rawVel) - smoothVel) * 0.08;

  /* ── Instrument HUD ─────────────────────────── */
  const strikeEnvTarget = strikeActive ? Math.max(0, 1 - strikeTime / STRIKE_DURATION) : 0;
  strikeEnvSmoothed += (strikeEnvTarget - strikeEnvSmoothed) * 0.1;
  updateHud(now, p, strikeEnvSmoothed, strikeActive && strikeTime < 3.2);
  waveInk = themeMuted;

  /* ── Silver adapts: brighter, cleaner metal as the room darkens ── */
  const b = 0.9 + p * 0.06;
  silverMat.color.setRGB(b, b, b + 0.015);
  silverMat.roughness = 0.24 - p * 0.09;
  silverMat.envMapIntensity = 1.15 + p * 0.75;
  gripMat.color.setRGB(b - 0.05, b - 0.05, b - 0.03);
  gripMat.envMapIntensity = 0.8 + p * 0.4;

  /* ── Fork pose: scroll choreography + breath + pointer lean ── */
  pointer.x += (pointer.tx - pointer.x) * 0.055;
  pointer.y += (pointer.ty - pointer.y) * 0.055;

  const breatheY = REDUCED ? 0 : Math.sin(now * 0.55) * 0.045;
  forkGroup.position.y = -centerY + breatheY;
  forkGroup.rotation.y = scrollState.spinY + pointer.x * 0.1;
  forkGroup.rotation.z = THREE.MathUtils.degToRad(scrollState.tiltZ);
  forkGroup.rotation.x = pointer.y * 0.055;

  /* ── Camera ─────────────────────────────────── */
  camera.position.x = Math.sin(scrollState.camAngle) * camDist + pointer.x * 0.22;
  camera.position.z = Math.cos(scrollState.camAngle) * camDist;
  camera.position.y = scrollState.camY - pointer.y * 0.16;
  camera.lookAt(0, 0, 0);

  /* ── Standing-wave field stays anchored to the instrument ───────── */
  // The room's rings should radiate from the thing that makes the sound.
  frameN++;
  if (frameN % 5 === 0) {
    const [rt1, rt2] = getProngTipWorldPositions();
    const rs1 = projectToScreen(rt1);
    const rs2 = projectToScreen(rt2);
    const rx = Math.min(80, Math.max(20, ((rs1.x + rs2.x) / 2 / window.innerWidth) * 100));
    const ry = Math.min(70, Math.max(8, ((rs1.y + rs2.y) / 2 / window.innerHeight) * 100));
    if (Math.abs(rx - ringX) > 0.4 || Math.abs(ry - ringY) > 0.4) {
      ringX = rx; ringY = ry;
      ringField.style.setProperty('--ring-x', rx.toFixed(1) + '%');
      ringField.style.setProperty('--ring-y', ry.toFixed(1) + '%');
    }
  }

  /* ── Lighting: the darker the room, the more the metal is rimmed ── */
  keyLight.intensity = 1.15 + p * 0.5;
  rimLight.intensity = 0.7 + p * 1.0;
  rimLight2.intensity = p * 0.85 + (pointer.overFork ? 0.25 : 0);
  ambientLight.intensity = 0.22 + p * 0.06;
  frontFill.intensity = 0.2 + p * 0.35;
  if (afterglow && !REDUCED) {
    rimLight.intensity += Math.sin(now * 1.3) * 0.12 * p;
  }

  /* ── Strike effect ──────────────────────────── */
  if (strikeActive) {
    strikeTime += dt;
    vibrateProng();

    // ── Animate SVG displacement filter on DOM elements ──
    if (domDisplace && domTurb && domRippleEls.length > 0) {
      const [tipL, tipR] = getProngTipWorldPositions();
      const sL = projectToScreen(tipL);
      const sR = projectToScreen(tipR);
      const forkCX = (sL.x + sR.x) / 2;
      const forkCY = (sL.y + sR.y) / 2;

      // Animate global turbulence frequency for organic wave motion.
      // Decay is brisk on purpose: the type may shiver, never break —
      // the shockwave lives in the rings and the canvas, not the words.
      const globalDecay = Math.exp(-strikeTime * 1.0);
      const freqBase = 0.012 + Math.sin(strikeTime * 1.8) * 0.008 * globalDecay;
      const freqY = freqBase * 0.55;
      domTurb.setAttribute('baseFrequency', `${freqBase.toFixed(4)} ${freqY.toFixed(4)}`);
      domTurb.setAttribute('seed', Math.floor(strikeTime * 8).toString());

      // Ripple wavefront expands outward from epicenter
      const wavefrontRadius = strikeTime * 450; // px per second expansion
      const wavefrontWidth = 300; // width of the active ripple band

      domRippleEls.forEach(el => {
        const rect = el.getBoundingClientRect();
        const elCX = rect.left + rect.width / 2;
        const elCY = rect.top + rect.height / 2;
        const dist = Math.sqrt((elCX - forkCX) ** 2 + (elCY - forkCY) ** 2);

        const distFromWavefront = Math.abs(dist - wavefrontRadius);
        const bandInfluence = Math.max(0, 1 - distFromWavefront / wavefrontWidth);
        const elDecay = Math.exp(-strikeTime * 1.1);

        const ripplePhase = Math.sin((dist * 0.008) - strikeTime * 4) * bandInfluence * elDecay;
        const tx = ripplePhase * 2;
        const ty = ripplePhase * 1;
        el.style.transform = `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px)`;
        el.style.transition = 'none';
      });

      // Set shared filter displacement to the max active level
      const peakScale = globalDecay * 18;
      domDisplace.setAttribute('scale', peakScale.toFixed(2));
    }

    if (strikeTime > STRIKE_DURATION) {
      strikeActive = false;
      afterglow = true;
      if (ctaBtn) ctaBtn.classList.add('ringing');
      rippleCtx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      usePostRipple = false;
      // Clean up DOM ripple filters and transforms
      domRippleEls.forEach(el => {
        el.style.filter = '';
        el.style.willChange = '';
        el.style.transform = '';
        el.style.transition = '';
      });
      domRippleEls.length = 0;
      if (domDisplace) domDisplace.setAttribute('scale', '0');
    }
  }

  // Render with post-processing ripple when active
  if (usePostRipple && strikeActive) {
    // Update shader uniforms
    rippleShaderMat.uniforms.uTime.value = strikeTime;
    const decay = Math.exp(-strikeTime * 0.5);
    rippleShaderMat.uniforms.uIntensity.value = decay;
    // ── Dynamic epicenter: project fork midpoint to UV space ──
    const [wlS, wrS] = getProngTipWorldPositions();
    const midWorld = new V3(
      (wlS.x + wrS.x) / 2,
      (wlS.y + wrS.y) / 2,
      (wlS.z + wrS.z) / 2
    );
    const projected = midWorld.clone().project(camera);
    const uvX = projected.x * 0.5 + 0.5;
    const uvY = projected.y * 0.5 + 0.5; // UV y is bottom-up in shader
    rippleShaderMat.uniforms.uCenter.value.set(uvX, uvY);

    // Pass 1: render scene to texture
    renderer.setRenderTarget(renderTarget);
    renderer.render(scene, camera);
    renderer.setRenderTarget(null);

    // Pass 2: render ripple-distorted quad to screen
    rippleShaderMat.uniforms.tDiffuse.value = renderTarget.texture;
    renderer.render(postScene, postCamera);
  } else {
    renderer.render(scene, camera);
  }

  // Draw 2D ripple rings AFTER 3D render
  drawRipples(dt, now);
}
animate();

/* ── Resize ───────────────────────────────────── */
window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
  const pr = Math.min(window.devicePixelRatio, DPR_CAP);
  renderTarget.setSize(window.innerWidth * pr, window.innerHeight * pr);
  sizeRippleCanvas();
  sizeWave();
});

})();
</script>
</body>
</html>
